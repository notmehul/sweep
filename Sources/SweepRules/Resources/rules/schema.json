{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sweep.local/rules/schema.json",
  "title": "Sweep cleanup rule file",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/rule" },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "match", "conditions", "bucket", "action", "group", "title",
        "explain", "developer", "unit", "priority"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$" },
        "match": { "$ref": "#/$defs/match" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "bucket": { "enum": ["rebuilds", "review", "yours", "dontTouch"] },
        "action": {
          "oneOf": [
            { "enum": ["delete", "trash", "showOnly"] },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["toolCommand"],
              "properties": {
                "toolCommand": {
                  "enum": [
                    "simctlRuntimeDelete", "brewCleanup", "npmCacheClean",
                    "uvCacheClean", "bunCacheRm"
                  ]
                }
              }
            }
          ]
        },
        "group": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "explain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["whatItIs", "ifRemoved", "whyStale"],
          "properties": {
            "whatItIs": { "type": "string", "minLength": 1 },
            "ifRemoved": { "type": "string", "minLength": 1 },
            "whyStale": { "type": "string", "minLength": 1 }
          }
        },
        "developer": { "type": "boolean" },
        "unit": { "type": "boolean" },
        "priority": { "type": "integer" }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "pathGlob": { "type": "string", "minLength": 1 },
        "regex": { "type": "string", "minLength": 1 },
        "parentMarker": { "type": "string", "minLength": 1 },
        "bundleIDPattern": { "type": "string", "minLength": 1 },
        "gitignored": { "type": "boolean" }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minAgeDays": { "type": "integer", "minimum": 0 },
        "appInstalled": { "type": "string", "minLength": 1 },
        "appNotInstalled": { "type": "string", "minLength": 1 },
        "appNotRunning": { "type": "string", "minLength": 1 },
        "cleanRepo": { "type": "boolean" },
        "notSymlinkTarget": { "type": "boolean" },
        "requiresSpotlight": { "type": "boolean" }
      }
    }
  }
}
